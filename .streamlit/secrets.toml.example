# Copy to .streamlit/secrets.toml (gitignored) for local runs, or paste the
# same keys into the hosting platform's secrets settings. Never commit real values.

GEMINI_API_KEY   = "your-gemini-api-key"          # Google AI Studio key (use a team/service key, not a personal one)
METABASE_API_KEY = "mb_your-metabase-api-key"     # Metabase > Admin > Authentication > API keys; server needs Syfe VPN
BUILDER_PASSWORD = "choose-a-strong-password"     # gate for the Portfolio Builder page; Builder stays locked if unset

# Optional: shared saved-portfolio storage. If unset, the app falls back to Data/saved_portfolios.json.
SUPABASE_URL = "https://your-project.supabase.co"
SUPABASE_KEY = "your-supabase-publishable-key"
